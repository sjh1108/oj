# Production env file for the algoj API boxes (OJ, EOJ).
# Place at /opt/algoj/.env (chmod 600) on BOTH boxes — deploy-api-single.sh
# passes it to the API container with --env-file. JWT_SECRET must be identical
# on the two boxes or tokens issued by one are rejected by the other.
#
# Generate strong values before deploy:
#   openssl rand -base64 48   → JWT_SECRET (≥ 32 chars for HS512)

# ─── Database (AWS RDS, MySQL 8) ─────────────────────────────
DB_HOST=__RDS_ENDPOINT__
DB_PORT=3306
DB_NAME=algoj
DB_USER=algoj
DB_PASSWORD=__FROM_RDS__

# ─── JWT ─────────────────────────────────────────────────────
JWT_SECRET=__GENERATE__
JWT_ACCESS_TTL_MS=3600000
JWT_REFRESH_TTL_MS=604800000

# ─── Judge0 / RabbitMQ (JJ 박스, 사설망) ──────────────────────
JUDGE0_URL=http://__JJ_PRIVATE_IP__:2358
RABBITMQ_HOST=__JJ_PRIVATE_IP__
RABBITMQ_PORT=5672
RABBITMQ_USER=algoj
RABBITMQ_PASSWORD=__SAME_AS_JJ__
# Judge0 박스의 MAX_MEMORY_LIMIT(judge0.conf)과 **같은 값**으로 맞춘다. 앱은 이 값으로 잘라서
# 보내며 박스 상한을 모르므로, 이 값이 박스보다 크면 422로 거절된다(순서: 박스 → 앱).
# 현재 JJ 박스는 스톡 기본값 512000 — deploy/judge0/memory-limit.md 참고.
JUDGE0_MAX_MEMORY_LIMIT_KB=512000

# ─── 스케줄러 (다박스) ────────────────────────────────────────
# PENDING 제출 재큐잉 스위퍼는 한 박스에서만 돌린다(중복 실행은 낭비).
# OJ: 미설정(=활성) · EOJ: false. deploy/redundancy.md §4 참고.
#SWEEPER_ENABLED=false

# ─── CORS ────────────────────────────────────────────────────
# Add Vercel domain after frontend deploy.
# Multiple origins: comma-separated.
CORS_ALLOWED_ORIGINS=https://algoj.duckdns.org,https://__YOUR_VERCEL_DOMAIN__.vercel.app

# ─── Discord bot (optional) ──────────────────────────────────
# Shared secret between backend and the Discord bot. Generate:
#   openssl rand -base64 32
# Leave unset to disable /api/internal/** (bot endpoints fail closed).
BOT_API_KEY=__GENERATE__
DISCORD_LINK_CODE_TTL_SECONDS=600

# ─── S3 지문 이미지 (optional) ────────────────────────────────
# 설정하면 관리자 이미지 업로드(POST /api/images)가 활성화된다.
# 버킷/IAM 세팅 절차는 deploy/aws-s3-images.md 참고.
# 미설정이면 이미지 업로드만 503(I003)을 반환하고 나머지는 정상 동작.
#AWS_ACCESS_KEY_ID=__FROM_IAM_CONSOLE__
#AWS_SECRET_ACCESS_KEY=__FROM_IAM_CONSOLE__
#S3_IMAGE_BUCKET=algoj-images
#AWS_REGION=ap-northeast-2

# ─── Server / profile ────────────────────────────────────────
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod
