# DB 백업을 박스 밖으로 올릴 설정 — deploy/backup-db.sh 가 읽는다.
# /opt/algoj/backup.env 로 복사해 채우고 chmod 600. 절차는 deploy/backup.md.
#
# .env 와 따로 두는 이유: .env 는 deploy-api.sh 가 API 컨테이너에 통째로 넣는다.
# 백업용 로그인 정보까지 API가 볼 필요는 없다.
#
# 아무것도 채우지 않으면 로컬 백업만 한다. 둘 다 채우면 둘 다 올린다.

# ─── rclone (Google Drive 등) — 기본 ─────────────────────────
# <rclone 원격 이름>:<폴더>. 로그인 정보는 /opt/algoj/rclone/rclone.conf (backup.md 2절).
BACKUP_RCLONE_REMOTE=gdrive:algoj-backups
# 원격에서 이 일수보다 오래된 백업을 지운다.
BACKUP_REMOTE_KEEP_DAYS=30

# ─── S3 호환 스토리지 (AWS S3·OCI Object Storage·Cloudflare R2) — 선택 ─
#BACKUP_S3_BUCKET=algoj-backups
# AWS S3 면 비워 둔다. OCI 예: https://<네임스페이스>.compat.objectstorage.<리전>.oraclecloud.com
#BACKUP_S3_ENDPOINT=
#BACKUP_S3_REGION=
#BACKUP_S3_PREFIX=db
#BACKUP_S3_ACCESS_KEY_ID=__FROM_STORAGE_CONSOLE__
#BACKUP_S3_SECRET_ACCESS_KEY=__FROM_STORAGE_CONSOLE__
