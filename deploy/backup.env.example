# DB 백업을 박스 밖으로 올릴 S3 호환 스토리지 설정 — deploy/backup-db.sh 가 읽는다.
# /opt/algoj/backup.env 로 복사해 채우고 chmod 600. 절차는 deploy/backup.md.
#
# .env 와 따로 두는 이유: .env 는 deploy-api.sh 가 API 컨테이너에 통째로 넣는다.
# 백업용 키까지 API가 볼 필요는 없다.
#
# 이 파일이 없거나 BACKUP_S3_BUCKET 이 비어 있으면 로컬 백업만 한다.

BACKUP_S3_BUCKET=algoj-backups
# AWS S3 면 비워 둔다. OCI Object Storage 예:
#   https://<네임스페이스>.compat.objectstorage.<리전>.oraclecloud.com
# Cloudflare R2 예:
#   https://<계정 ID>.r2.cloudflarestorage.com
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_PREFIX=db
BACKUP_S3_ACCESS_KEY_ID=__FROM_STORAGE_CONSOLE__
BACKUP_S3_SECRET_ACCESS_KEY=__FROM_STORAGE_CONSOLE__
