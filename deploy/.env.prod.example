# Production env file for the algoj box (Oracle Cloud, 단일 박스).
# Place at /opt/algoj/.env (chmod 600). deploy-api.sh passes it to the API
# container with --env-file, and the compose files (MySQL·RabbitMQ·봇) read it
# with `--env-file .env`. 새로 세우는 순서는 deploy/oracle-cloud-migration.md.
#
# Generate strong values before deploy:
#   openssl rand -base64 48   → JWT_SECRET (≥ 32 chars for HS512)
#   openssl rand -base64 24   → DB_PASSWORD · MYSQL_ROOT_PASSWORD · RABBITMQ_PASSWORD
#
# DB 백업 업로드 설정은 여기 두지 않는다 — 이 파일은 API 컨테이너에 통째로 들어간다.
# 백업은 /opt/algoj/backup.env (deploy/backup.env.example, deploy/backup.md).

# ─── Database (algoj-mysql, docker-compose.oci.yml) ─────────
# 컨테이너 이름으로 닿는다 — 호스트 포트는 열지 않는다.
DB_HOST=mysql
DB_PORT=3306
DB_NAME=algoj
DB_USER=algoj
DB_PASSWORD=__GENERATE__
# compose가 MySQL을 처음 만들 때 쓰고, backup-db.sh가 덤프에 쓴다.
MYSQL_ROOT_PASSWORD=__GENERATE__

# ─── JWT ─────────────────────────────────────────────────────
# 바꾸면 기존 로그인 세션이 전부 끊긴다. 박스를 옮길 때는 값을 그대로 가져온다.
JWT_SECRET=__GENERATE__
JWT_ACCESS_TTL_MS=3600000
JWT_REFRESH_TTL_MS=604800000

# ─── 채점 (judge-runner) / RabbitMQ ───────────────────────────
# 둘 다 algoj-net 안에서 서비스 이름으로 닿는다.
JUDGE0_URL=http://judge-runner:2358
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=algoj
RABBITMQ_PASSWORD=__GENERATE__

# PENDING 제출 재적재 스위퍼. 박스가 하나이므로 켜 둔다(기본값).
#SWEEPER_ENABLED=true

# ─── CORS ────────────────────────────────────────────────────
# Multiple origins: comma-separated.
CORS_ALLOWED_ORIGINS=https://oj-oui2.vercel.app

# ─── Discord bot (optional) — deploy/README.md "Discord 봇" ──
# Shared secret between backend and the Discord bot. Generate:
#   openssl rand -base64 32
# Leave unset to disable /api/internal/** (bot endpoints fail closed).
BOT_API_KEY=__GENERATE__
DISCORD_LINK_CODE_TTL_SECONDS=600
# 봇 컨테이너(docker-compose.bot.yml)가 읽는 값
#DISCORD_TOKEN=
#DISCORD_CLIENT_ID=
#DISCORD_GUILD_ID=
#OJ_WEB_BASE_URL=https://oj-oui2.vercel.app   # 프론트 도메인 (API 도메인 아님)
# 배포 공지 채널. 비워 두면 공지만 꺼진다.
#DISCORD_ANNOUNCE_CHANNEL_ID=

# ─── 선정 문제 알림 (optional) ───────────────────────────────
# 관리자 일괄 업로드 화면의 "선정 문제 알림" 버튼이 이 웹훅으로 보낸다.
# 디스코드 채널 설정 → 연동 → 웹후크 → 새 웹후크 → URL 복사. 비워 두면 버튼이 꺼진다.
#DISCORD_PROBLEM_WEBHOOK_URL=https://discord.com/api/webhooks/__ID__/__TOKEN__
# 알림 맨 앞에 멘션할 역할 ID (개발자 모드 → 역할 우클릭 → ID 복사). 이 역할만 울린다.
#DISCORD_PROBLEM_ROLE_ID=

# ─── 지문 이미지 스토리지 (optional) ──────────────────────────
# 지금은 비워 둔다 — S3 버킷은 지웠고 지문 그림은 인라인 SVG로 넣는다.
# 설정하면 관리자 이미지 업로드(POST /api/images)가 활성화된다. S3 호환 스토리지(OCI·R2)는
# deploy/oracle-cloud-migration.md 6단계. AWS S3면 ENDPOINT·PUBLIC_BASE_URL은 비운다.
# 미설정이면 이미지 업로드만 503(I003)을 반환하고 나머지는 정상 동작.
#AWS_ACCESS_KEY_ID=__FROM_STORAGE_CONSOLE__
#AWS_SECRET_ACCESS_KEY=__FROM_STORAGE_CONSOLE__
#S3_IMAGE_BUCKET=algoj-images
#AWS_REGION=ap-northeast-2
#S3_ENDPOINT=
#S3_PUBLIC_BASE_URL=

# ─── Server / profile ────────────────────────────────────────
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod
